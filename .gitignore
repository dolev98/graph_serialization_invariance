# Python / experiment artefacts
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.env
# instances.jsonl is tracked: it pins which graphs/tasks were sampled, so an
# upstream change to the HuggingFace Erdos dataset cannot silently alter results.
# variants.jsonl is derived from it deterministically, so it is regenerated.
data/processed/*/variants.jsonl
results/*
!results/*/
results/*/*
!results/*/tables/
!results/*/figs/
# Keep the audit and paper-metric outputs alongside the published analysis.
!results/review/*.json
!results/review/*.csv
!results/review/floor/
# Outputs of the offline smoke check (configs/smoke.yaml)
results/smoke/

# LaTeX intermediate files
*.aux
*.auxlock
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.lof
*.lot
*.loa
*.lol
*.synctex
*.synctex.gz
*.synctex(busy)
*.synctex.gz(busy)

# BibTeX and Biber
*.bbl
*.bcf
*.blg
*.run.xml

# Beamer
*.nav
*.snm
*.vrb

# Glossaries and nomenclature
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.ist
*.xdy
*.nlo
*.nls

# Indexes
*.idx
*.ilg
*.ind

# Alternate compiler output
*.dvi
*.xdv
*.ps

# Packages that generate auxiliary files or directories
*.dep
*.dpth
*.md5
*.pyg
*.pytxcode
_minted-*/
pythontex-files-*/


